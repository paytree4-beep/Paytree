# PayTree.me environment variables
#
# Copy this file to .env.local for development and fill in real values.
# NEVER commit .env.local or any file that holds real keys. On your host
# (Vercel, Cloudflare, etc.) add the same names in its environment settings.
#
# Variables that start with NEXT_PUBLIC_ are sent to every visitor's browser.
# They must never hold a secret. Everything else stays on the server.
#
# The "Phase" note says when each value starts to be used.

# --- Site (Phase 1) ---------------------------------------------------------
# Public address of the site, with no trailing slash. Optional on Vercel: the
# production address Vercel assigns is used automatically until this is set.
# Set it once the real domain (paytree.me) is connected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Sign-ups open automatically once Supabase is connected.
# Set to "false" to close them (the homepage then shows "Sign-ups open soon").
# NEXT_PUBLIC_SIGNUPS_OPEN=false

# --- Supabase: database and sign-in (Phase 2) --------------------------------
# On Vercel, the Supabase integration fills these in automatically.
# Locally, find them in your Supabase project: Project Settings > API.
# The URL and the anon key are designed to be public. Row Level Security in the
# database is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses all database security. Server only. Never prefix it with
# NEXT_PUBLIC_, never log it, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sensitive payment details (Phase 4) ------------------------------------
# 32 random bytes, base64 encoded, used to encrypt bank account and routing
# numbers before they are saved. Generate one with:
#   openssl rand -base64 32
# SECRET. If you lose it, saved bank details cannot be read again. Keep a
# backup in a password manager.
PAYMENT_DATA_ENCRYPTION_KEY=

# --- Rate limiting (Phase 7) -------------------------------------------------
# Upstash Redis REST credentials. SECRET.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (Phase 2, if you use custom email sending) ------------------------
# SECRET.
# RESEND_API_KEY=

# --- Sign-up abuse protection (Phase 8) --------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Error monitoring (Phase 10, optional) -----------------------------------
# SENTRY_DSN=

# --- Billing (Phase 6) -------------------------------------------------------
# Intentionally empty. The billing provider has not been chosen yet. Its keys
# will be added here when it is.
